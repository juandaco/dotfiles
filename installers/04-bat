#!/usr/bin/env bash
#
# Installs or updates `bat`.

source "$(dirname "${BASH_SOURCE[0]}")/lib/common.sh" || exit 1

case "$PLATFORM" in
macos) brew_install bat ;;
arch) pacman_install bat ;;
debian)
  GIT_REPO="sharkdp/bat"
  VERSION="$(github_latest_version "$GIT_REPO")" || fail "Could not find the latest version of bat."

  if [ "$(installed_version bat)" != "$VERSION" ]; then
    echo "Installing bat $VERSION..."

    case "$(linux_arch)" in
    arm64 | armhf | amd64) ;;
    *) unsupported_arch ;;
    esac

    install_deb "https://github.com/$GIT_REPO/releases/download/v$VERSION/bat_${VERSION}_$(linux_arch).deb"
    verify_installed bat "$VERSION"
  fi
  ;;
*) unsupported_platform ;;
esac
