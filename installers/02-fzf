#!/usr/bin/env bash
#
# Installs or updates `fzf`.

source "$(dirname "${BASH_SOURCE[0]}")/lib/common.sh" || exit 1

# Generates `~/.fzf.bash` (sourced by `~/.bashrc`) without asking questions nor
# editing the shell configuration files.
FZF_INSTALL_OPTIONS=(--key-bindings --completion --no-update-rc --no-zsh --no-fish)

case "$PLATFORM" in
macos)
  brew_install fzf
  [ -f "$HOME/.fzf.bash" ] || "$(brew --prefix)/opt/fzf/install" "${FZF_INSTALL_OPTIONS[@]}"
  ;;
arch) pacman_install fzf ;;
debian | linux)
  GIT_REPO="junegunn/fzf"
  FZF_HOME="$HOME/.fzf"

  if [ ! -d "$FZF_HOME" ]; then
    # Install fzf when not present
    echo "Installing fzf..."
    git clone --quiet --depth 1 "https://github.com/$GIT_REPO.git" "$FZF_HOME" || fail "Could not clone fzf."
    "$FZF_HOME/install" "${FZF_INSTALL_OPTIONS[@]}" || fail "fzf was not installed."
  else
    # Update if needed
    FZF_REVISION="$(git -C "$FZF_HOME" rev-parse HEAD)"
    git -C "$FZF_HOME" pull --quiet --ff-only || fail "Could not update fzf."

    if [ "$FZF_REVISION" != "$(git -C "$FZF_HOME" rev-parse HEAD)" ] || [ ! -f "$HOME/.fzf.bash" ]; then
      echo "Updating fzf..."
      "$FZF_HOME/install" "${FZF_INSTALL_OPTIONS[@]}" || fail "fzf was not updated."
    fi
  fi
  ;;
*) unsupported_platform ;;
esac
