#!/usr/bin/env bash
#
# Installs or updates `fd`.

source "$(dirname "${BASH_SOURCE[0]}")/lib/common.sh" || exit 1

case "$PLATFORM" in
macos) brew_install fd ;;
arch) pacman_install fd ;;
debian)
  GIT_REPO="sharkdp/fd"
  VERSION="$(github_latest_version "$GIT_REPO")" || fail "Could not find the latest version of fd."

  if [ "$(installed_version fd)" != "$VERSION" ]; then
    echo "Installing fd $VERSION..."

    case "$(linux_arch)" in
    arm64 | armhf | amd64) ;;
    *) unsupported_arch ;;
    esac

    install_deb "https://github.com/$GIT_REPO/releases/download/v$VERSION/fd_${VERSION}_$(linux_arch).deb"
    verify_installed fd "$VERSION"
  fi
  ;;
*) unsupported_platform ;;
esac
