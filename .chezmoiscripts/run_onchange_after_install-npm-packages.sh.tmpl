{{- if .packages.npm -}}

#!/usr/bin/env bash

set -euo pipefail

{{ template "brew-env" . }}

{{- with includeTemplate "brew-node-formula" . }}
PATH="${HOMEBREW_PREFIX:-/opt/homebrew}/opt/{{ . }}/bin:$PATH"
{{- end }}

{{- $sudo := (eq .chezmoi.os "linux") | ternary "sudo " "" }}

if command -v npm >/dev/null 2>&1; then
  {{ $sudo }}npm install -g {{ .packages.npm | join " " }}
else
  echo "npm not found, skipping global npm packages" >&2
fi
{{- end }}
