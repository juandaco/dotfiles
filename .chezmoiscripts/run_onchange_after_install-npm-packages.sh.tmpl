{{- if .packages.npm -}}

#!/usr/bin/env bash

set -euo pipefail

{{ $sudo := (eq .chezmoi.os "linux") | ternary "sudo" "" -}}
if command -v npm >/dev/null 2>&1; then
  {{ $sudo }} npm install -g {{ .packages.npm | join " " }}
else
  echo "npm not found, skipping global npm packages" >&2
fi
{{- end }}
