#!/usr/bin/env bash
# gh path, so a skipped run is retried once gh is installed: {{ lookPath "gh" }}

set -euo pipefail

{{ template "brew-env" . }}

if ! command -v gh >/dev/null 2>&1; then
  echo "gh not found, skipping gh-dash" >&2
elif grep -q "dlvhdr/gh-dash" <<<"$(gh extension list)"; then
  echo "gh-dash already installed"
else
  gh extension install dlvhdr/gh-dash
fi
