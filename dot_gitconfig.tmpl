[user]
  name = Juan David Acosta
  email = {{ .email }}
  username = {{ .email }}
[init]
  defaultBranch = main
[pull]
  ff = only
[core]
  editor = nvim
[diff]
  tool = default-difftool
[difftool "default-difftool"]
  cmd = code --wait --diff $LOCAL $REMOTE
  prompt = false
[alias]
  co = checkout
  br = branch
  ci = commit
  st = status
  unstage = reset HEAD --
  last = log -1 HEAD
  rp = rev-parse HEAD
  dr = log --oneline --graph --all --decorate
  rb = rebase
  ignore = "!gi() { curl -sL https://www.toptal.com/developers/gitignore/api/$@ ;}; gi"
  dd = -c core.pager=delta diff
  dl = -c core.pager=delta log -p
  ds = -c core.pager=delta show
[delta]
  navigate = true
  side-by-side = true
  line-numbers = true
{{/*
vim: ft=gitconfig
*/}}
