{{- $work := and (eq .chezmoi.os "darwin") (promptBoolOnce . "work" "Work MacBook?") -}}
{{- $defaultEmail := ($work | ternary "JuanDavid.Acosta@adidas.com" "juandacorias@gmail.com") -}}
{{- $email := promptStringOnce . "email" "Email address" $defaultEmail -}}
data:
  email: {{ $email }}
  work: {{ $work }}
{{- if lookPath "delta" }}
diff:
  pager: delta
{{- end }}
